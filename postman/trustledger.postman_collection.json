      "value": "http://localhost:8001",
      "type": "string"
    },
    {
      "key": "nodeToken",
      "value": "dev-token",
      "type": "string"
    },
    {
      "key": "serial",
      "value": "X123",
      "type": "string"
    },
    {
      "key": "sku",
      "value": "NMB-P8-128",
      "type": "string"
    },
    {
      "key": "storeA",
      "value": "store_a",
      "type": "string"
    },
    {
      "key": "storeB",
      "value": "store_b",
      "type": "string"
    },
    {
      "key": "checkoutId",
      "value": "",
      "type": "string"
    },
    {
