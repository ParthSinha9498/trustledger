# ---- PayPal (mock runs fully offline; set to "sandbox" with real credentials) ----
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYPAL_SDK_DOMAINS=localhost   # root domain(s) for browser client tokens, e.g. onrender.com

# ---- LLM: any OpenAI-compatible provider. Gemini by default. ----
LLM_MODE=live                 # "mock" = scripted stand-in, no key needed
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AGENT_MODEL=gemini-3.5-flash
# Groq instead:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# AGENT_MODEL=openai/gpt-oss-120b

# ---- Postgres: each service gets only its own database ----
BRAND_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/trustledger_brand
PAYPAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/trustledger_paypal_side
PLATFORM_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/trustledger_platform

# ---- Internal ----
NODE_SHARED_TOKEN=change-me
PAYER_HASH_KEY=change-me   # secret for the keyed hash of payer IDs (PayPal-side node only)
BRAND_ID=nimbus
CURRENT_WEEK=42
DAILY_EPSILON=5.0
CORS_ORIGINS=http://localhost:3000

# ---- Case alerts (Zapier catch hook or Slack incoming webhook) ----
NOTIFY_WEBHOOK_URL=
PUBLIC_WEB_URL=http://localhost:3000

# ---- Web ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AG_GRID_LICENSE=
