{
  "info": {
    "_postman_id": "8c3b6f0e-2d4a-4f5b-9e1c-7a2d5b6c9e01",
    "name": "TrustLedger",
    "description": "Product authenticity as a condition of PayPal payment. Generated by scripts/build_postman.py; see postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Demo flow (platform API)",
      "description": "The same-serial story. Run top to bottom against a freshly seeded stack (`python -m backend.seed`), because a captured serial stays sold.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/health",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('api is up', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('paypalMode', pm.response.json().paypal_mode);"
                ]
              }
            }
          ]
        },
        {
          "name": "Scan at Store A (verified, PayPal order created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiBaseUrl}}/checkout/scan",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "checkout",
                "scan"
              ]
            },
            "description": "Brand verifies X123 at Store A, so the platform creates a PayPal order with the verification id in custom_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"store_id\": \"{{storeA}}\",\n  \"serial\": \"{{serial}}\",\n  \"sku\": \"{{sku}}\",\n  \"amount\": 899.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('VERIFIED', () => pm.expect(r.status).to.eql('VERIFIED'));",
                  "pm.test('PayPal order exists', () => pm.expect(r.paypal_order_id).to.be.a('string'));",
                  "pm.collectionVariables.set('checkoutId', r.checkout_id);",
                  "pm.collectionVariables.set('paypalOrderId', r.paypal_order_id);",
                  "pm.collectionVariables.set('verificationId', r.verification_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Capture Store A payment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/checkout/{{checkoutId}}/capture",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "checkout",
                "{{checkoutId}}",
                "capture"
              ]
            },
            "description": "Mock mode captures directly. In sandbox mode the buyer must approve the order first (PayPal buttons in the web app), otherwise PayPal answers 422."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('brand verified receipt', () => pm.expect(pm.response.json().brand_verified).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Receipt",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/receipts/{{checkoutId}}",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "receipts",
                "{{checkoutId}}"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('ids match', () => {",
                  "  pm.expect(r.verification_id).to.eql(pm.collectionVariables.get('verificationId'));",
                  "  pm.expect(r.paypal_order_id).to.eql(pm.collectionVariables.get('paypalOrderId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Scan same serial at Store B (blocked, no PayPal order)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{apiBaseUrl}}/checkout/scan",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "checkout",
                "scan"
              ]
            },
            "description": "Store B is not in X123's supply chain. No PayPal call is made and a case opens for the brand.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"store_id\": \"{{storeB}}\",\n  \"serial\": \"{{serial}}\",\n  \"sku\": \"{{sku}}\",\n  \"amount\": 899.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('NOT_VERIFIED', () => pm.expect(r.status).to.eql('NOT_VERIFIED'));",
                  "pm.test('NOT_IN_CHANNEL', () => pm.expect(r.reason_code).to.eql('NOT_IN_CHANNEL'));",
                  "pm.test('no PayPal order', () => pm.expect(r.paypal_order_id).to.eql(null));",
                  "pm.collectionVariables.set('caseId', r.case_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List cases",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/cases",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "cases"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ids = pm.response.json().map(c => c.case_id);",
                  "pm.test('Store B case listed', () => pm.expect(ids).to.include(pm.collectionVariables.get('caseId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Failed authenticity checks by week (cockpit chart)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/cockpit/blocked",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "cockpit",
                "blocked"
              ]
            },
            "description": "Exact counts of failed brand checks by week, reason and store, asked of the brand node's aggregate API (no buyer data, no privacy budget)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('exact brand counts', () => pm.expect(r.exact).to.eql(true));",
                  "pm.test('includes the Store B block', () => pm.expect(r.by_store.some(x => x.store_id === pm.collectionVariables.get('storeB'))).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Case detail (agent steps)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/cases/{{caseId}}",
              "host": [
                "{{apiBaseUrl}}"
              ],
              "path": [
                "cases",
                "{{caseId}}"
              ]
            },
            "description": "Re-send until status is `complete`; the worker fills in steps as it investigates."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const c = pm.response.json();",
                  "pm.test('case found', () => pm.expect(c.case_id).to.eql(pm.collectionVariables.get('caseId')));",
                  "console.log('case status', c.status, 'steps', c.steps.length);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Brand verification API (contract)",
      "description": "What a brand implements (openapi/brand-verification.yaml). Calls go straight to the mock brand node and need X-Node-Token. These calls do not create PayPal orders.",
      "auth": {
        "type": "apikey",
        "apikey": [
          {
            "key": "key",
            "value": "X-Node-Token",
            "type": "string"
          },
          {
            "key": "value",
            "value": "{{nodeToken}}",
            "type": "string"
          },
          {
            "key": "in",
            "value": "header",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Verify X123 at Store B (NOT_IN_CHANNEL)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{brandBaseUrl}}/v1/verify",
              "host": [
                "{{brandBaseUrl}}"
              ],
              "path": [
                "v1",
                "verify"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serial\": \"{{serial}}\",\n  \"sku\": \"{{sku}}\",\n  \"store_id\": \"{{storeB}}\",\n  \"requested_at\": \"{{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('NOT_VERIFIED / NOT_IN_CHANNEL', () => {",
                  "  pm.expect(r.result).to.eql('NOT_VERIFIED');",
                  "  pm.expect(r.reason_code).to.eql('NOT_IN_CHANNEL');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify X123 at Store A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{brandBaseUrl}}/v1/verify",
              "host": [
                "{{brandBaseUrl}}"
              ],
              "path": [
                "v1",
                "verify"
              ]
            },
            "description": "VERIFIED on a fresh seed; ALREADY_SOLD once the demo flow captured X123.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serial\": \"{{serial}}\",\n  \"sku\": \"{{sku}}\",\n  \"store_id\": \"{{storeA}}\",\n  \"requested_at\": \"{{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('valid verdict', () => pm.expect(['VERIFIED', 'NOT_VERIFIED']).to.include(r.result));",
                  "pm.collectionVariables.set('brandVerificationId', r.verification_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify unknown serial",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{brandBaseUrl}}/v1/verify",
              "host": [
                "{{brandBaseUrl}}"
              ],
              "path": [
                "v1",
                "verify"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serial\": \"NOPE-0000\",\n  \"sku\": \"{{sku}}\",\n  \"store_id\": \"{{storeA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('UNKNOWN_SERIAL', () => pm.expect(pm.response.json().reason_code).to.eql('UNKNOWN_SERIAL'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify without token (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{brandBaseUrl}}/v1/verify",
              "host": [
                "{{brandBaseUrl}}"
              ],
              "path": [
                "v1",
                "verify"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serial\": \"{{serial}}\",\n  \"sku\": \"{{sku}}\",\n  \"store_id\": \"{{storeA}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Confirm sale",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{brandBaseUrl}}/v1/verify/{{brandVerificationId}}/confirm",
              "host": [
                "{{brandBaseUrl}}"
              ],
              "path": [
                "v1",
                "verify",
                "{{brandVerificationId}}",
                "confirm"
              ]
            },
            "description": "Marks the serial sold. 404 if the verification was not VERIFIED. Running this on a fresh seed marks X123 sold, so reseed before the demo flow.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paypal_order_id\": \"POSTMAN-TEST-ORDER\",\n  \"captured_at\": \"{{$isoTimestamp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 or 404', () => pm.expect([200, 404]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "apiBaseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
